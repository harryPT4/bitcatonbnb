# Pooled Neon connection for application traffic.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Direct Neon connection for Drizzle migrations.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require

# Random secret used to irreversibly hash rate-limit identifiers.
RATE_LIMIT_SALT=replace-with-at-least-32-random-characters
